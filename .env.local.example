# Kopiere diese Datei zu .env.local und trage deine echten Werte ein.
# .env.local wird von Git ignoriert (siehe .gitignore) - Keys landen nie im Repo.

# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Supabase-Projekt -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gleiche Supabase-Projekt-URL, zusätzlich der Anon/Public-Key (Project
# Settings -> API -> Project API keys -> anon public). Diese beiden landen
# im Browser-Bundle - anders als der Service-Role-Key oben ist das so
# vorgesehen, Row-Level-Security schützt die Daten trotzdem.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Beliebiger geheimer String, z. B. `openssl rand -hex 32`. Pflicht, sobald
# der Ship-Research-Cron aktiv ist - ohne gesetztes Secret lehnt
# /api/cron/refresh-ship-research jeden Aufruf ab (fail-closed).
CRON_SECRET=

# serper.dev -> API Key. Für die gezielte Google-Suche der Liegezeiten-Recherche
# (findet die passende Fahrplanseite, siehe berth-time-research.ts).
SERPER_API_KEY=

# firecrawl.dev -> API Key. Für das zuverlässige Abrufen der gefundenen
# Fahrplanseite (übernimmt JS-Rendering/Anti-Bot, siehe berth-time-research.ts).
FIRECRAWL_API_KEY=
